<node id="meeting-08-26-2014-item-E-1">
  <data key="d0">agenda_item</data>
  <data key="d1">Item E-1</data>
  <data key="d15">E-1</data>
  <data key="d10">An Emergency Ordinance of the City Commission of Coral Gables, Florida, making it unlawful for any person or persons without being authorized, licensed, or invited by the property owner or his or her lawful agent, including renters, to willfully enter or remain in any dwelling; further making it unlawful to commit an invasion of privacy in someone's home; establishing a $500 fine and imposing a term of imprisonment not to exceed 60 days for violation hereof; providing an exception for law enforcement officers and government officials acting under lawful process or other lawful authority; and urging the legislature and governor to adopt legislation related to unlawful entry into an occupied dwelling, and providing for Severability, Repealer, Codification, and an Effective Date.</data>
  <data key="d14"></data>
  <data key="d16">14-3291</data>
  <data key="d17"></data>
  <data key="d18"></data>
  <data key="d19">E. PUBLIC HEARINGS</data>
  <data key="d11"></data>
  <data key="d20">[{"url": "http://coralgables.legistar.com/gateway.aspx?m=l&amp;id=/matter.aspx?key=9209", "text": "14-3291", "page": 6, "coordinates": {"x0": 103.0, "y0": 235.0, "x1": 166.0, "y1": 247.0}}]</data>
  <data key="d7">0.008902077151335312</data>
  <data key="d8">0.0014152359756959164</data>
</node>
<node id="doc-document-14-3291">
  <data key="d0">document</data>
  <data key="d1">Document 14-3291</data>
  <data key="d21">Document</data>
  <data key="d22">14-3291</data>
  <data key="d10">An Emergency Ordinance of the City Commission of Coral Gables, Florida, making it unlawful for any person or persons without being authorized, licensed, or invited by the property owner or his or her lawful agent, including renters, to willfully enter or remain in any dwelling; further making it unlawful to commit an invasion of privacy in someone's home; establishing a $500 fine and imposing a term of imprisonment not to exceed 60 days for violation hereof; providing an exception for law enforcement officers and government officials acting under lawful process or other lawful authority; and urging the legislature and governor to adopt legislation related to unlawful entry into an occupied dwelling, and providing for Severability, Repealer, Codification, and an Effective Date.</data>
  <data key="d23">14-3291 - 08_26_2014.pdf</data>
  <data key="d2">08.26.2014</data>
